# Copy this file to secrets.yaml and fill in your base64-encoded values
# To encode: echo -n 'your-value' | base64
# NEVER commit secrets.yaml — it's in .gitignore
apiVersion: v1
kind: Secret
metadata:
  name: caloriemind-secrets
  namespace: caloriemind
type: Opaque
data:
  POSTGRES_USER: <base64-encoded>
  POSTGRES_PASSWORD: <base64-encoded>
  POSTGRES_DB: <base64-encoded>
  SESSION_SECRET: <base64-encoded>
  GROQ_API_KEY: <base64-encoded>
  AWS_ACCESS_KEY_ID: <base64-encoded>
  AWS_SECRET_ACCESS_KEY: <base64-encoded>
